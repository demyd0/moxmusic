rules_version = '2';

// mox music — Firebase Storage Security Rules
//
// profileTracks/{uid}/{fileName}   uploaded "profile music" audio file
//   - publicly readable (the track plays on the owner's public profile)
//   - only the owner may upload/delete their own files
//   - capped at 10MB, must be an audio/* content type
//
// Deploy with: firebase deploy --only storage
// (or paste this file into Firebase Console -> Storage -> Rules -> Publish)

service firebase.storage {
  match /b/{bucket}/o {
    match /profileTracks/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
