rules_version = '2';

// mox music — Firestore Security Rules
//
// Data model:
//   users/{uid}                 private profile (includes email) — owner only
//     users/{uid}/liked/{id}    liked albums — publicly readable (powers /share/:uid), owner-writable
//     users/{uid}/toListen/{id} to-listen queue — owner only, never shared publicly
//     users/{uid}/followedArtists/{artistId}  followed artists — publicly readable, owner-writable
//   publicProfiles/{uid}        public-safe mirror (username + photoURL only, no email)
//   usernames/{name}            handle -> uid uniqueness registry
//   follows/{followerUid_followingUid}  one doc per follow relationship
//   conversations/{uid1_uid2}   DM between two mutual-follows, uid1 < uid2 in the doc id
//     conversations/{id}/messages/{id}  individual messages (content immutable, reactions map is not)
//   albumReactions/{albumId}    global public emoji reactions, doc is a uid -> emoji map
//
// Deploy with: firebase deploy --only firestore:rules
// (requires the Firebase CLI and firebase.json pointing at this file)

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Private profile document — contains email, so only the owner may read it.
      // (The public /share/:uid page reads from `publicProfiles` instead.)
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);

      match /liked/{albumId} {
        // Publicly readable so anonymous visitors can view a shared collection.
        allow read: if true;
        allow write: if isOwner(uid);
      }

      match /toListen/{albumId} {
        // Never exposed publicly — no share feature reads this subcollection.
        allow read: if isOwner(uid);
        allow write: if isOwner(uid);
      }

      match /followedArtists/{artistId} {
        // Publicly readable, same reasoning as liked/{albumId} - shows up
        // as a public "who they follow" detail rather than being private.
        allow read: if true;
        allow write: if isOwner(uid);
      }
    }

    match /publicProfiles/{uid} {
      // Username + photoURL only. Safe for anyone to read.
      allow read: if true;
      allow write: if isOwner(uid);

      // Anyone (including signed-out visitors) may bump the public view
      // counter by exactly 1 and touch nothing else - this is what powers
      // the profile view count without letting a visitor overwrite the
      // owner's bio/background/customization.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
                    && request.resource.data.viewCount ==
                       (resource.data.viewCount is int ? resource.data.viewCount : 0) + 1;
    }

    match /usernames/{name} {
      // Needed so the client can check handle availability before claiming one.
      allow read: if true;

      // Claiming a fresh handle: only as yourself.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;

      // Only the current owner of a handle may update or release it —
      // this is what actually prevents username hijacking; the client-side
      // uniqueness check alone (checkUsernameAvailable in userService.ts)
      // cannot be trusted, since anyone can call the Firestore SDK directly.
      allow update, delete: if isOwner(resource.data.uid);
    }

    match /follows/{followId} {
      // Follower/following counts and lists are public, same as everything
      // else on a profile page.
      allow read: if true;

      // Doc id must be "{followerUid}_{followingUid}" and match the auth'd
      // user as the follower - prevents both spoofing someone else's follow
      // and following yourself.
      allow create: if request.auth != null
                    && request.resource.data.followerUid == request.auth.uid
                    && request.resource.data.followingUid != request.auth.uid
                    && followId == request.resource.data.followerUid + '_' + request.resource.data.followingUid;

      // Unfollow: only the follower who created it.
      allow delete: if isOwner(resource.data.followerUid);
    }

    match /conversations/{conversationId} {
      function isMutualFollow(a, b) {
        return exists(/databases/$(database)/documents/follows/$(a + '_' + b))
            && exists(/databases/$(database)/documents/follows/$(b + '_' + a));
      }

      // Only the two participants may read a conversation - it's a private DM.
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;

      // Doc id must be "{uid1}_{uid2}" in exactly the order the two uids
      // appear in participants - makes the id deterministic (one
      // conversation per pair) without trusting the client's sort. Chat is
      // scoped to mutual follows only, per product decision.
      allow create: if request.auth != null
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2
                    && request.auth.uid in request.resource.data.participants
                    && conversationId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
                    && isMutualFollow(request.resource.data.participants[0], request.resource.data.participants[1]);

      // Updating last-message preview / read state - the participants list
      // itself can never change after creation.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        allow read: if request.auth != null && request.auth.uid in conversation().participants;

        allow create: if request.auth != null
                      && request.auth.uid in conversation().participants
                      && request.resource.data.senderId == request.auth.uid
                      && (
                           (request.resource.data.text is string
                            && request.resource.data.text.size() > 0
                            && request.resource.data.text.size() <= 2000)
                           || request.resource.data.album is map
                         );

        // Text/album content is immutable once sent - the only allowed
        // update is the reactions map (any participant can react).
        allow update: if request.auth != null
                      && request.auth.uid in conversation().participants
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if false;
      }
    }

    match /albumReactions/{albumId} {
      // Global, public reaction counts on an album/track - everyone can
      // read; each user may only ever touch their own single key in the
      // uid -> emoji map, whether that's the first reaction (create) or
      // changing/removing their reaction on an existing doc (update).
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly([request.auth.uid]);
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if false;
    }
  }
}
